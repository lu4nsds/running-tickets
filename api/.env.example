#--------------------------------------------
# [APP]
#--------------------------------------------
APP_NAME="Running Tickets"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file

#--------------------------------------------
# [SERVER]
#--------------------------------------------
PHP_CLI_SERVER_WORKERS=4

#--------------------------------------------
# [SECURITY]
#--------------------------------------------
BCRYPT_ROUNDS=12

#--------------------------------------------
# [LOGGING]
#--------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=errorlog
LOG_LEVEL=debug

#--------------------------------------------
# [DATABASE]
#--------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=running_tickets
DB_USERNAME=laravel
DB_PASSWORD=secret

#--------------------------------------------
# [CACHE]
#--------------------------------------------
CACHE_STORE=redis

#--------------------------------------------
# [SESSION]
#--------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

#--------------------------------------------
# [REDIS]
#--------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

#--------------------------------------------
# [QUEUE & BROADCAST]
#--------------------------------------------
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log

#--------------------------------------------
# [STORAGE]
# public = filesystem público local (desenvolvimento)
# s3     = Railway Object Storage (produção)
#--------------------------------------------
FILESYSTEM_DISK=public

#--------------------------------------------
# [AWS S3 / RAILWAY OBJECT STORAGE]
# Para Railway: AWS_USE_PATH_STYLE_ENDPOINT=true
# Endpoint e URL públicas disponíveis no painel do Railway > Object Storage.
#--------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

#--------------------------------------------
# [MAIL]
# Desenvolvimento: Mailpit (http://localhost:8025)
# Produção: Resend (MAIL_MAILER=resend + RESEND_API_KEY)
#--------------------------------------------
MAIL_MAILER=smtp
MAIL_FROM_ADDRESS="noreply@runningtickets.com"
MAIL_FROM_NAME="${APP_NAME}"

# smtp — Mailpit local
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null

# resend (produção)
RESEND_API_KEY=

#--------------------------------------------
# [FRONTEND]
#--------------------------------------------
VITE_APP_NAME="${APP_NAME}"
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

#--------------------------------------------
# [CORS]
# Para ngrok, adicione a URL aqui também
#--------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

#--------------------------------------------
# [GOOGLE OAUTH]
# Cadastrar em: https://console.cloud.google.com/
#--------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="http://localhost/api/auth/google/callback"

#--------------------------------------------
# [MERCADO PAGO]
#--------------------------------------------
# Credenciais da conta da plataforma — usadas no modo de recebimento
# "centralizado" (payout_mode=platform), onde o valor cai na nossa conta.
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
# Número máximo de parcelas permitido no parcelamento (padrão: 3)
MERCADOPAGO_MAX_INSTALLMENTS=3

# --- Split de pagamento (OAuth Marketplace) ---
# Necessário para o organizador conectar a conta dele e para o application_fee.
# Obtidos ao registrar a Running Tickets como aplicação Marketplace no painel
# de desenvolvedores do Mercado Pago. Sem eles, o split não funciona (o modo
# centralizado continua operando normalmente).
MERCADOPAGO_APP_ID=
MERCADOPAGO_CLIENT_SECRET=
# Deve ser idêntica à redirect URI cadastrada na aplicação do MP.
# Ex.: https://api.seudominio.com/api/organizer/payment-account/callback
MERCADOPAGO_OAUTH_REDIRECT_URI=

# Opcional: valida a assinatura x-signature do webhook. Vazio = validação pulada.
MERCADOPAGO_WEBHOOK_SECRET=

#--------------------------------------------
# WhatsApp Gateway
#--------------------------------------------
# WHATSAPP_GATEWAY_ENABLED=false -> apenas loga, não envia
WHATSAPP_GATEWAY_ENABLED=true
WHATSAPP_GATEWAY_BASE_URL=http://whatsapp-gateway:3000
WHATSAPP_GATEWAY_API_KEY=
WHATSAPP_GATEWAY_TENANT_UUID=
WHATSAPP_GATEWAY_TIMEOUT=15
