# =============================================================================
# Stage 1: Builder — Compilação do TypeScript
# =============================================================================
FROM node:24.14-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# =============================================================================
# Stage 2: Runner — Ambiente de execução
# =============================================================================
FROM node:24.14-alpine

WORKDIR /app

# Instala apenas dependências de produção
COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

# Copia build do stage anterior
COPY --from=builder /app/dist ./dist

# Usa o usuário "node" já existente na imagem oficial (uid 1000)
USER node

ENV PORT=3000
EXPOSE $PORT

CMD ["node", "dist/main"]
