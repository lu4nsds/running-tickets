# =============================================================================
# VARIÁVEIS DE AMBIENTE — WhatsApp Gateway
# =============================================================================
# Porta do servidor HTTP
PORT=3000

# Limite do corpo das requisições JSON. Documentos (PDF) trafegam em base64, então
# o default do Express (100kb) é insuficiente. Aceita formatos do pacote `bytes`
# (ex.: 10mb, 5mb). Opcional — default 10mb.
PAYLOAD_SIZE_LIMIT=10mb

# Identidade da instância (opcional). Se vazio, é derivada de hostname + uuid.
INSTANCE_ID=

# Redis (credenciais de sessão Baileys são persistidas no Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Base de TODAS as chaves/canais Redis (o ':' separador é adicionado pelo código).
# Permite múltiplos deployments compartilharem um Redis sem colisão. Obrigatório.
REDIS_PREFIX=whatsapp:gateway

# Configurações do Baileys (biblioteca de conexão com WhatsApp Web)
WHATSAPP_API_KEY=
WHATSAPP_CONNECT_TIMEOUT_MS=30000
WHATSAPP_BAILEYS_LOG_LEVEL=debug
# Nome do dispositivo exibido no WhatsApp ao parear. Obrigatório.
WHATSAPP_DEVICE_NAME="WhatsApp Gateway"

# Reconexão automática (backoff exponencial em quedas transientes)
# Após WHATSAPP_RECONNECT_MAX_ATTEMPTS tentativas seguidas sem sucesso, as
# credenciais são limpas e um novo pareamento via QR passa a ser necessário.
WHATSAPP_RECONNECT_MAX_ATTEMPTS=5
WHATSAPP_RECONNECT_BASE_DELAY_MS=2000
WHATSAPP_RECONNECT_MAX_DELAY_MS=60000

# Escala horizontal (multi-instância)
# Cada tenant é "dono" de exatamente uma instância via lock no Redis. O lock
# (e o estado de sessão) tem TTL de WHATSAPP_OWNERSHIP_TTL_MS, renovado a cada
# WHATSAPP_HEARTBEAT_INTERVAL_MS. O loop de reconciliação reivindica sessões
# órfãs (failover) a cada WHATSAPP_RECONCILE_INTERVAL_MS. Operações de socket
# (send/remove) são roteadas à instância dona via RPC sobre Redis pub/sub, com
# timeout de WHATSAPP_RPC_TIMEOUT_MS.
WHATSAPP_OWNERSHIP_TTL_MS=30000
WHATSAPP_HEARTBEAT_INTERVAL_MS=10000
WHATSAPP_RECONCILE_INTERVAL_MS=20000
WHATSAPP_RPC_TIMEOUT_MS=15000
